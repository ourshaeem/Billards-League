# Optional. Copy to Mobile/.env to point the app at a different backend.
# Without it, the app uses the live server: https://billards-league.onrender.com
#
# Expo builds this into the app and caches it, so after changing it run
#   npx expo start --clear
#
# A backend on your own computer, reached from:
#   a phone on the same wifi (your computer's LAN address):
#EXPO_PUBLIC_API_BASE=http://192.168.1.50:5000
#   the Android emulator (10.0.2.2 is the computer; localhost is the emulator):
#EXPO_PUBLIC_API_BASE=http://10.0.2.2:5000
#   the iOS simulator (it shares the computer's localhost):
#EXPO_PUBLIC_API_BASE=http://localhost:5000
#
# Anything named EXPO_PUBLIC_ ends up inside the app, readable by anyone
# who has it - so never put a secret here.
