# Copy this file to Backend/.env and fill in your own values.
#
#   cp Backend/.env.example Backend/.env
#
# Backend/.env is already covered by .gitignore, so it stays on your
# machine and out of the repository.
#
# Locally, DB_PASSWORD is required - there is no password in the code any
# more, and without it the app stops and says so. Everything else is
# optional and falls back to this machine's MySQL.
#
# In production (Render, Railway...) these are set as the host's
# environment variables instead - the Docker image never contains a .env.
# There, DATABASE_URL and JWT_SECRET_KEY are required, and the app refuses
# to start without them (the image sets APP_ENV=production).

# --- Database ---
# Either the whole connection string...
#
#   AWS RDS, encrypted (the Docker image includes Amazon's certificates):
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@ENDPOINT:3306/DB_NAME?ssl_ca=/app/certs/rds-global-bundle.pem
#
# A password containing @ : / ? # % must be percent-encoded in the URL
# (@ -> %40, / -> %2F...), or use the separate DB_* settings below, which
# need no encoding. A plain mysql:// URL is accepted too.
#DATABASE_URL=

# ...or the pieces, which is what local development normally uses:
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ranked_billards
DB_PORT=3306

# --- Auth ---
# Used to sign login tokens. Anyone who knows this string can forge a
# login as any player, so it should be long and random. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Server ---
# Which websites may call the API from a browser: * for any (the current
# default, while the mobile app is built), or a comma-separated list such
# as https://league.example.com. Native mobile apps don't use this.
CORS_ORIGINS=*

PORT=5000
# Set to 0 when this is running anywhere other than your own machine.
# Flask's debug mode exposes an interactive console on errors.
FLASK_DEBUG=1
# Set to 1 to expose /debug/start-match, which force-starts matches with
# no login required. Handy while developing, must be off for the league.
ENABLE_DEBUG_ROUTES=0

# --- Privacy policy (GET /privacy) ---
# The contact address the privacy policy shows. Set it on the live server
# (Render's environment variables); without it the page tells people to
# ask whoever runs their league. Don't commit a real address here.
#PRIVACY_CONTACT_EMAIL=

# Emailing password reset codes, through Brevo's HTTPS API (Render's free
# plan blocks SMTP). Free at brevo.com, 300 emails a day: add a sender
# under Senders (they email it a confirmation link), then make an API key
# under SMTP & API > API keys. Set these on the live server (Render's
# environment variables). Without them, "Forgot your password?" tells
# people to ask the organiser - who can run `flask --app app set-password
# <username>` - and locally the email is printed to the log instead.
# Never commit a real key here.
#BREVO_API_KEY=
#MAIL_FROM_ADDRESS=
#MAIL_FROM_NAME=Billiards & Ping Pong League

# --- The league's own time ---
# When "today", "this week" (from Monday) and "this month" begin, for the
# players of the day, week and month. Any IANA name; New York if unset.
#LEAGUE_TIMEZONE=America/New_York

# --- Production only (the Docker image) ---
# Set by the Dockerfile. Makes a missing DATABASE_URL or JWT_SECRET_KEY a
# startup error instead of a quiet fallback to the local settings.
#APP_ENV=production
# gunicorn worker processes, and threads in each. Defaults suit 512 MB-1 GB.
#WEB_CONCURRENCY=2
#GUNICORN_THREADS=4


# ---------------------------------------------------------------------
# HEADS UP, worth doing once and forgetting about:
#
# The local MySQL password used to be written in Backend/database.py, and
# a JWT signing key in Backend/app.py. Both are gone from the code now,
# but still in this repo's git history, and the repo is on GitHub.
#   1. Change the password on your local MySQL, then put the new one in
#      Backend/.env (never back into database.py).
#   2. The live server never uses either: production refuses to start
#      without its own DATABASE_URL and JWT_SECRET_KEY, set in Render.
# ---------------------------------------------------------------------
