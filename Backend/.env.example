# Copy this file to Backend/.env and fill in your own values.
#
#   cp Backend/.env.example Backend/.env
#
# Backend/.env is already covered by .gitignore, so it stays on your
# machine and out of the repository.
#
# Locally, everything here is optional: if .env is missing, the app falls
# back to the values that were previously hardcoded, so nothing breaks.
#
# In production (Render, Railway...) these are set as the host's
# environment variables instead - the Docker image never contains a .env.
# There, DATABASE_URL and JWT_SECRET_KEY are required, and the app refuses
# to start without them (the image sets APP_ENV=production).

# --- Database ---
# Either the whole connection string...
#
#   AWS RDS, encrypted (the Docker image includes Amazon's certificates):
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@ENDPOINT:3306/DB_NAME?ssl_ca=/app/certs/rds-global-bundle.pem
#
# A password containing @ : / ? # % must be percent-encoded in the URL
# (@ -> %40, / -> %2F...), or use the separate DB_* settings below, which
# need no encoding. A plain mysql:// URL is accepted too.
#DATABASE_URL=

# ...or the pieces, which is what local development normally uses:
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ranked_billards
DB_PORT=3306

# --- Auth ---
# Used to sign login tokens. Anyone who knows this string can forge a
# login as any player, so it should be long and random. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Server ---
# Which websites may call the API from a browser: * for any (the current
# default, while the mobile app is built), or a comma-separated list such
# as https://league.example.com. Native mobile apps don't use this.
CORS_ORIGINS=*

PORT=5000
# Set to 0 when this is running anywhere other than your own machine.
# Flask's debug mode exposes an interactive console on errors.
FLASK_DEBUG=1
# Set to 1 to expose /debug/start-match, which force-starts matches with
# no login required. Handy while developing, must be off for the league.
ENABLE_DEBUG_ROUTES=0

# --- Production only (the Docker image) ---
# Set by the Dockerfile. Makes a missing DATABASE_URL or JWT_SECRET_KEY a
# startup error instead of a quiet fallback to the local settings.
#APP_ENV=production
# gunicorn worker processes, and threads in each. Defaults suit 512 MB-1 GB.
#WEB_CONCURRENCY=2
#GUNICORN_THREADS=4


# ---------------------------------------------------------------------
# HEADS UP, worth doing once and forgetting about:
#
# The real MySQL password was committed in Backend/database.py, and the
# JWT signing key in Backend/app.py. Both are in this repo's git history
# and the repo is on GitHub, so anyone who has seen it has both.
#
# Moving them into .env (which this change does) stops NEW commits
# leaking them, but does not remove them from past commits. To be safe:
#   1. Change the MySQL password on your database, then put the new one
#      in Backend/.env (never back into database.py).
#   2. Pick a new JWT_SECRET_KEY here. Everyone gets logged out once,
#      which is the point - old tokens stop working.
# ---------------------------------------------------------------------
